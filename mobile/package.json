{
  "name": "sime-loop",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --lan",
    "web": "expo start --web --port 8081",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web",
    "export:native": "expo export --platform android --platform ios --output-dir dist-native",
    "format": "prettier --write App.tsx index.ts src"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.17",
    "expo-camera": "~58.0.12",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.9",
    "expo-image-picker": "~58.0.10",
    "expo-notifications": "~58.1.6",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-qrcode-svg": "^6.3.27",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  }
}
