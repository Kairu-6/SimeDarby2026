DATABASE_PATH=data/simeloop.sqlite3
DEMO_MODE=true
DEVICE_API_KEY=hackathon-device-key-change-me
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
VISION_ENABLED=true
VISION_MODEL=openai/clip-vit-base-patch32
VISION_THRESHOLD=0.60
# Enable after configuring an EAS native build and Expo push credentials.
PUSH_NOTIFICATIONS_ENABLED=false
FOOD_POINTS_PER_KG=50
RECYCLABLE_POINTS_PER_KG=100
MAX_ITEM_KG=4.0
MIN_ITEM_G=10
EMPTY_PLATE_G=5
WEIGHT_TOLERANCE_G=5
TELEMETRY_MAX_AGE_SECONDS=15
CLASSIFICATION_MAX_AGE_SECONDS=60
FULL_BIN_BLOCKS_STATION=false
# Kiosk key is a separate tablet pairing credential, required in real mode.
KIOSK_API_KEY=
PUBLIC_APP_URL=http://localhost:8081
KIOSK_QR_TTL_SECONDS=180
# Optional isolated static-web preview; normal hardware API leaves these unset.
WEB_BUILD_PATH=
PUBLIC_PREVIEW=false
